module(
    name = "krabka_streams_go",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.52.2")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.5")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_apache_arrow_go_v18",
    "com_github_hamba_avro_v2",
    "com_github_santhosh_tekuri_jsonschema_v6",
    "org_golang_google_protobuf",
    "org_golang_x_text",
)
