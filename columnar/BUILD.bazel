load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "columnar",
    srcs = [
        "barrier.go",
        "barrieralign.go",
        "barriercut.go",
        "blob.go",
        "built.go",
        "codec.go",
        "gzip.go",
        "ipc.go",
        "join.go",
        "jsonbridge.go",
        "ops.go",
        "records.go",
        "rowcodec.go",
        "runner.go",
        "statestore.go",
        "support.go",
        "topology.go",
        "values.go",
    ],
    importpath = "github.com/krabka-io/krabka-streams-go/columnar",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_apache_arrow_go_v18//arrow",
        "@com_github_apache_arrow_go_v18//arrow/array",
        "@com_github_apache_arrow_go_v18//arrow/decimal128",
        "@com_github_apache_arrow_go_v18//arrow/decimal256",
        "@com_github_apache_arrow_go_v18//arrow/ipc",
        "@com_github_apache_arrow_go_v18//arrow/memory",
    ],
)

go_test(
    name = "columnar_test",
    srcs = [
        "barrier_test.go",
        "barrieralign_test.go",
        "barriercut_test.go",
        "example_test.go",
        "ipc_blob_test.go",
        "ops_topology_test.go",
        "rowcodec_jsonbridge_test.go",
        "runner_test.go",
        "stateful_test.go",
        "testdata_test.go",
    ],
    embed = [":columnar"],
    deps = [
        "@com_github_apache_arrow_go_v18//arrow",
        "@com_github_apache_arrow_go_v18//arrow/array",
        "@com_github_apache_arrow_go_v18//arrow/memory",
    ],
)

# Inputs for //:docsite-site; example_test.go files contribute the runnable
# examples shown on the API reference site.
filegroup(
    name = "docsite_srcs",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ) + glob(
        ["example_test.go"],
        allow_empty = True,
    ),
    visibility = ["//:__pkg__"],
)
