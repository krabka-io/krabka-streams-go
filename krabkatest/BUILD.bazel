load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "krabkatest",
    srcs = [
        "registrystub.go",
        "testdriver.go",
    ],
    importpath = "github.com/krabka-io/krabka-streams-go/krabkatest",
    visibility = ["//visibility:public"],
    deps = ["//columnar"],
)

go_test(
    name = "krabkatest_test",
    srcs = [
        "example_test.go",
        "krabkatest_test.go",
    ],
    embed = [":krabkatest"],
    deps = [
        "//columnar",
        "//schema",
        "@com_github_apache_arrow_go_v18//arrow/memory",
    ],
)

# Inputs for //:docsite-site; example_test.go files contribute the runnable
# examples shown on the API reference site.
filegroup(
    name = "docsite_srcs",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ) + glob(
        ["example_test.go"],
        allow_empty = True,
    ),
    visibility = ["//:__pkg__"],
)
