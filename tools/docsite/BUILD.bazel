load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "docsite_lib",
    srcs = [
        "highlight.go",
        "main.go",
    ],
    importpath = "github.com/krabka-io/krabka-streams-go/tools/docsite",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "docsite",
    embed = [":docsite_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "docsite_test",
    srcs = [
        "highlight_test.go",
        "main_test.go",
    ],
    embed = [":docsite_lib"],
)
